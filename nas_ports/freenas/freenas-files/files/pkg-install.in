#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin::/usr/local/sbin:/usr/local/bin

pre-install()
{
}

post-install()
{
        set -x

        echo "Making freenas initial database"
        if [ ! -d /data ]; then
                rm -fr /data
                mkdir -p /data
        fi

        # Установщик при обновлении кладёт сохранённую конфигурацию в /data
        # ДО установки пакетов (install.sh: cp -pR /tmp/data_preserved/. /tmp/data/data),
        # а этот скрипт затем генерировал начальную базу прямо поверх неё — и все
        # настройки пользователя пропадали. Уводим существующую базу в сторону,
        # генерируем эталонную для factory-v1.db, затем возвращаем пользовательскую.
        _preserved_db=""
        if [ -f /data/freenas-v1.db ]; then
                _preserved_db=/data/freenas-v1.db.preserved
                cp -p /data/freenas-v1.db "${_preserved_db}"
                rm -f /data/freenas-v1.db
        fi

        env FREENAS_INSTALL=yes /usr/local/sbin/migrate93 -f /data/freenas-v1.db
        # Lets be evil here and kill pkg(8) if this fails
        # because pkg does not check return code of POST-INSTALL script
        if [ $? -ne 0 ]; then
                /usr/bin/procstat -h $$|awk '{print $2}'|xargs kill -9
        fi

        env FREENAS_INSTALL=yes /usr/local/sbin/migrate113 -f /data/freenas-v1.db
        # Same as before
        if [ $? -ne 0 ]; then
                /usr/bin/procstat -h $$|awk '{print $2}'|xargs kill -9
        fi

        env FREENAS_INSTALL=yes /usr/local/sbin/migrate
        # Same as before
        if [ $? -ne 0 ]; then
                /usr/bin/procstat -h $$|awk '{print $2}'|xargs kill -9
        fi

        # В генерируемой базе root получает /usr/bin/zsh — путь из Linux-ветки
        # общей кодовой базы. Во FreeBSD порты ставятся в /usr/local, файла по
        # этому пути нет, и пункт Shell в консольном меню падает с
        # "su: /usr/bin/zsh: No such file or directory".
        # В официальной TrueNAS CORE 13.3 у root стоит /usr/local/bin/zsh —
        # проверено на установленной 13.3-U1.2. Сам zsh у нас собирается
        # (shells/zsh в ports-system.pyd) и лежит именно там, так что чиним
        # путь, а не подменяем оболочку. Правка идёт до снятия эталона,
        # чтобы попасть и в factory-v1.db.
        /usr/local/bin/sqlite3 /data/freenas-v1.db \
            "UPDATE account_bsdusers SET bsdusr_shell='/usr/local/bin/zsh' WHERE bsdusr_shell='/usr/bin/zsh'"

        # Заводские значения, приехавшие из апстрима с чужим именем. Правим
        # здесь, до снятия эталона, чтобы попасть и в factory-v1.db: иначе
        # свежеустановленная машина зовётся truenas.local, здоровается
        # "Welcome to TrueNAS" и представляется в сети Windows как TrueNAS.
        # Существующие установки это не трогает — у них своя база.
        /usr/local/bin/sqlite3 /data/freenas-v1.db \
            "UPDATE network_globalconfiguration SET gc_hostname='bsdnas' WHERE gc_hostname='truenas'"
        /usr/local/bin/sqlite3 /data/freenas-v1.db \
            "UPDATE system_advanced SET adv_motd='Welcome to BSDnas' WHERE adv_motd='Welcome to TrueNAS'"
        /usr/local/bin/sqlite3 /data/freenas-v1.db \
            "UPDATE services_cifs SET cifs_srv_netbiosname='bsdnas' WHERE cifs_srv_netbiosname='truenas'"
        /usr/local/bin/sqlite3 /data/freenas-v1.db \
            "UPDATE services_cifs SET cifs_srv_description='BSDnas Server' WHERE cifs_srv_description='TrueNAS Server'"
        # Базовое имя iSCSI входит в имя каждой цели и запоминается
        # инициаторами. Меняем ТОЛЬКО заводское значение — у работающей
        # системы своя база, её basename останется прежним, и подключения не
        # оборвутся. Формат обычный: iqn.<год-месяц>.<домен наоборот>.
        /usr/local/bin/sqlite3 /data/freenas-v1.db \
            "UPDATE services_iscsitargetglobalconfiguration SET iscsi_basename='iqn.2026-08.com.bsdnas.ctl' WHERE iscsi_basename='iqn.2005-10.org.freenas.ctl'"

        cp /data/freenas-v1.db /data/factory-v1.db

        # Вернуть конфигурацию пользователя. Схему до актуальной доведут миграции
        # из post-upgrade пакета base-os.
        if [ -n "${_preserved_db}" ]; then
                mv "${_preserved_db}" /data/freenas-v1.db
        fi
}

backupwarning()
{
}

case $2 in
PRE-INSTALL)
        pre-install
        exit 0
        ;;
POST-INSTALL)
        post-install
        exit 0
        ;;
BACKUPWARNING)
        backupwarning
        exit 0
        ;;
*)
        exit 1
        ;;
esac
