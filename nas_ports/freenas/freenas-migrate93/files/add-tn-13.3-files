diff --git freenasUI/support/utils.py freenasUI/support/utils.py
new file mode 100644
index 0000000..dec4605
--- /dev/null
+++ freenasUI/support/utils.py
@@ -0,0 +1,23 @@
+import logging
+import os
+
+
+from licenselib.license import License
+
+log = logging.getLogger('support.utils')
+LICENSE_FILE = '/data/license'
+
+
+def get_license():
+    if not os.path.exists(LICENSE_FILE):
+        return None, 'ENOFILE'
+
+    with open(LICENSE_FILE, 'r') as f:
+        license_file = f.read().strip('\n')
+
+    try:
+        license = License.load(license_file)
+    except Exception as e:
+        return None, str(e)
+
+    return license, None
